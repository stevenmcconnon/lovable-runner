{
  "name": "lovable-runner",
  "version": "0.1.0",
  "description": "Local helper to create/fetch/publish Lovable projects via the REST API.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/cli.js",
    "serve": "node src/server.js",
    "fetch": "node src/cli.js fetch",
    "create": "node src/cli.js create",
    "publish": "node src/cli.js publish",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "SITE_SIGNING_SECRET=dev-signing-secret-0123456789abcdef ANALYTICS_QUEUE_URL=https://example.com/queue npm run build && SITE_SIGNING_SECRET=dev-signing-secret-0123456789abcdef ANALYTICS_QUEUE_URL=https://example.com/queue node --test \"api/tests/**/*.js\"",
    "dev:api": "ts-node --transpile-only api/src/dev-server.ts",
    "test:api": "node scripts/test-api.js",
    "test:api:full": "node scripts/test-openapi-full.js",
    "test:quota": "npm run build && node --test api/tests/launch-quota.test.js",
    "domains:refresh": "ts-node --transpile-only scripts/refresh-domain-https.ts",
    "domains:jobs": "ts-node --transpile-only scripts/process-domain-jobs.ts",
    "backfill:drafts": "node scripts/backfill-draft-prefix.js",
    "backfill:account-sites": "node scripts/backfill-account-sites.js",
    "backfill:job-events": "node scripts/backfill-job-events.js",
    "notifications:work": "node scripts/process-notification-jobs.js",
    "db:seed:plans": "node scripts/seed-subscription-plans.js",
    "integrations:migrate": "node scripts/migrate-integration-tokens.js",
    "analytics:rollup": "node scripts/rollup-site-metrics.js",
    "db:migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "lovable",
    "cli",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-acm": "^3.952.0",
    "@aws-sdk/client-cloudfront": "^3.952.0",
    "@aws-sdk/client-cloudformation": "^3.952.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.952.0",
    "@aws-sdk/client-dynamodb": "^3.952.0",
    "@aws-sdk/client-kms": "^3.952.0",
    "@aws-sdk/client-lambda": "^3.687.0",
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/client-secrets-manager": "^3.952.0",
    "@aws-sdk/client-ses": "^3.952.0",
    "@aws-sdk/client-sns": "^3.952.0",
    "@aws-sdk/client-sqs": "^3.687.0",
    "@aws-sdk/lib-dynamodb": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@fastify/aws-lambda": "^4.1.0",
    "@fastify/multipart": "^8.3.1",
    "aws-jwt-verify": "^4.0.1",
    "fast-xml-parser": "^5.3.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-raw-body": "^4.3.0",
    "pg": "^8.12.0",
    "stripe": "^16.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.137",
    "@types/node": "^20.14.14",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@11.6.3+sha512.4085a763162e0e3acd19a4e9d23ad3aa0978e501ccf947dd7233c12a689ae0bb0190763c4ef12366990056b34eec438903ffed38fde4fbd722a17c2a7407ee92"
}
