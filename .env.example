LOVABLE_API_BASE=https://api.lovable.dev
LOVABLE_ID_TOKEN=replace-with-id-token
# Workspace used for project creation (fill this from the URL you observed: /workspaces/{id}/projects)
LOVABLE_WORKSPACE_ID=replace-with-workspace-id
# Path to create endpoint (if different, set real one)
LOVABLE_CREATE_PATH=/workspaces/{workspaceId}/projects
# Path to publish endpoint; `{id}` is replaced with project id
LOVABLE_PUBLISH_PATH=/projects/{id}/publish

# Optional deploy defaults
LOVABLE_DEPLOY_BUCKET=
# Optional base prefix for deploy (e.g., "lovable" or "sites"); slug is appended
LOVABLE_DEPLOY_PREFIX=
