parameter_overrides = "DeployBucket=n8n-lovable ApiCustomDomainName=api.ai-sitemaker.com ApiCertificateArn=REPLACE_ME DBName=aisitemaker DBUsername=lovable_runner DBPassword=REPLACE_ME DBInstanceClass=db.t4g.micro DBAllocatedStorage=20 DbVpcId=REPLACE_ME DbSubnetIds=\"subnet-REPLACE_ME,subnet-REPLACE_ME\" DbAllowedCidr=0.0.0.0/0 NatGatewaySubnetId=REPLACE_ME LambdaPrivateSubnetACidr=172.31.96.0/20 LambdaPrivateSubnetBCidr=172.31.112.0/20 StripeSecretKey=REPLACE_ME StripeWebhookSecret=REPLACE_ME TemplateUploadBucket=lovable-template-uploads SiteSigningSecret=REPLACE_ME DefaultTrialEditLimit=1 GeminiApiKey=\"\" GeminiApiKeySecretArn=REPLACE_ME GeminiModel=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-pro-preview:generateContent OpenAIApiKey=\"\" OpenAIApiKeySecretArn=REPLACE_ME OpenAIModel=gpt-5.1 GoogleImageModel=imagen-3.0-generate-1 PreviewDomainName=preview.ai-sitemaker.com LiveDomainName=sites.ai-sitemaker.com CustomDomainOriginHost=sites.ai-sitemaker.com CustomDomainCanonicalDefault=apex CustomDomainDistributionId=REPLACE_ME CustomDomainCertRegion=us-east-1 CustomDomainPriceClass=PriceClass_All DomainBasePriceCents=1200 DomainPriceMarkupCents=300 DomainJobBatchLimit=10 DomainJobMaxRuntimeMs=60000 RunnerReservedConcurrency=0 DomainMaxPerAccount=5 DomainOrderDailyLimit=5 DomainRefreshDailyLimit=25 RateLimitRetentionMinutes=1440 AuditLogRetentionDays=30 TemplateLibraryBaseUrl=https://api.ai-sitemaker.com AnalyticsDatabaseUrl=REPLACE_ME SiteBuilderApiEnabled=true SiteDocsToken=REPLACE_ME UnsplashAccessKey=REPLACE_ME NamecheapApiUser=aisitemaker NamecheapApiKey=REPLACE_ME NamecheapUsername=aisitemaker NamecheapApiBase=https://api.namecheap.com/xml.response ContactFromEmail=formsubmissions@ai-sitemaker.com IntegrationKmsKeyArn=REPLACE_ME AlarmTopicArn=\"\" BackupRetentionDays=7 AnalyticsVisitorRetentionDays=90"
